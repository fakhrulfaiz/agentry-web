# Agentry settings for deploy/compose.yaml. Copy to .env next to it and fill in.
# Docker reads values literally: no quotes, no spaces around "=".

# ── Mode ──────────────────────────────────────────────────────────────────────
# Empty: web only (set AGENTRY_API_URL to your own Agentry API).
# full:  also run the Agentry API and its Postgres from the published images.
COMPOSE_PROFILES=full

# ── Agentry Web (always) ──────────────────────────────────────────────────────
AGENTRY_WEB_TAG=latest
# Port on this machine (default 3000).
# AGENTRY_WEB_PORT=3000

# Encrypts the session cookie; at least 32 bytes. Generate once and keep it
# (changing it signs everyone out): openssl rand -base64 32
AGENTRY_WEB_SESSION_SECRET=

# Session cookie: auto (Secure when the request came over HTTPS, so plain http:// on a LAN
# address works) | always (behind a TLS proxy that does not send X-Forwarded-Proto).
# AGENTRY_WEB_COOKIE_SECURE=auto

# Sign-in: apikey (each user enters their Agentry API key) | keycloak
AGENTRY_WEB_AUTH=apikey

# Web only: your Agentry API. From the container, a service on this machine is
# http://host.docker.internal:<port>. Leave unset in full mode (http://api:3080).
# AGENTRY_API_URL=http://host.docker.internal:3080

# Optional: models offered in the composer, comma-separated; the first is the default.
AGENTRY_WEB_MODELS=
# Optional: connector slugs shown first in Plugins > Apps, comma-separated.
AGENTRY_WEB_CONNECTORS_FEATURED=

# Keycloak sign-in only; the issuer must be reachable from the container and the browser.
AGENTRY_WEB_KEYCLOAK_ISSUER=
AGENTRY_WEB_KEYCLOAK_CLIENT_ID=agentry-web
AGENTRY_WEB_KEYCLOAK_CLIENT_SECRET=

# ── Agentry API and Postgres (full mode only) ─────────────────────────────────
AGENTRY_API_TAG=latest

# Password of the bundled Postgres; letters and digits only: openssl rand -hex 24.
# Keep it: it is set when the database is first created.
POSTGRES_PASSWORD=

# The API key users sign in with (owner "dev"); any long random string.
AGENTRY_DEV_KEY=

# Model provider key(s). DeepSeek:
DEEPSEEK_API_KEY=

# Optional: Composio Connect (apps for agents).
COMPOSIO_API_KEY=

# Optional: Agentry Sandbox, run separately. Set both or neither.
# AGENTRY_SANDBOX_URL=http://host.docker.internal:3090
# AGENTRY_SANDBOX_KEY=

# Optional: the API's public address behind a proxy.
# AGENTRY_PUBLIC_URL=
