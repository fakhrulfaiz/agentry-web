# Copy to .env.local and fill in. Every variable is read on the server only.

# Sign-in mode: keycloak | apikey
AGENTRY_WEB_AUTH=apikey

# Agentry API base URL (server-only; the browser never sees it)
AGENTRY_API_URL=http://localhost:4000

# Encrypts the agentry_session cookie. At least 32 bytes, e.g. `openssl rand -base64 32`
AGENTRY_WEB_SESSION_SECRET=

# Optional, production only: auto (default; Secure session cookie when the request came over
# HTTPS) | always (Secure on every request; for a TLS proxy that does not send X-Forwarded-Proto)
AGENTRY_WEB_COOKIE_SECURE=

# Optional: comma-separated model ids; the first is the default model
AGENTRY_WEB_MODELS=

# Required when AGENTRY_WEB_AUTH=keycloak
AGENTRY_WEB_KEYCLOAK_ISSUER=
AGENTRY_WEB_KEYCLOAK_CLIENT_ID=agentry-web
AGENTRY_WEB_KEYCLOAK_CLIENT_SECRET=
